   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "pointSize": 4
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "showValue": "auto",
    "legend": {
     "showLegend": false
    }
   },
   "transformations": [
    {
     "id": "reduce",
     "options": {
      "reducers": [
       "lastNotNull"
      ]
     }
    }
   ]
  },
  {
