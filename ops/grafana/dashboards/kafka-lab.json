{
 "uid": "kafka-lab",
 "title": "Kafka Lab Overview",
 "tags": [
  "kafka"
 ],
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "schemaVersion": 39,
 "version": 1,
 "panels": [
  {
   "id": 1,
   "title": "Total consumer lag",
   "type": "stat",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kafka_consumergroup_lag{consumergroup!~'inspector.*|shop-ui'})",
     "legendFormat": "lag"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "id": 2,
   "title": "Max partition lag",
   "type": "stat",
   "gridPos": {
